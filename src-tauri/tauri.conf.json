{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumiLooks",
  "version": "2.0.0",
  "identifier": "com.luminosweb.lumilooks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LumiLooks — LuminosWeb",
        "width": 1512,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0c060f"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:* blob: data:; media-src 'self' http://127.0.0.1:* blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LuminosWeb",
    "copyright": "Copyright © 2026 LuminosWeb",
    "category": "Photography",
    "homepage": "https://lumilooks.luminosweb.com",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Studio de looks et d’étalonnage photo et vidéo",
    "longDescription": "LumiLooks applique des looks cinéma et argentiques, des LUT 3D, des effets d’objectif et un étalonnage complet à vos photos et vidéos, entièrement sur votre ordinateur.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "binaries/licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
